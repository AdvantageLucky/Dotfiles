{{- /* Asked once per machine (`chezmoi init`), then kept in ~/.config/chezmoi/chezmoi.toml.
       base = tools that do not depend on a compositor (fish, nvim, kitty, btop)
       sway = base + the SwayFX desktop (bar, launcher, notifications, theme system) */ -}}
{{- $profile := promptChoiceOnce . "profile" "Profile" (list "base" "sway") "base" -}}

[data]
    profile = {{ $profile | quote }}
