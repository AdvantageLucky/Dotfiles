{{- $profile := get . "profile" | default "base" -}}
# Generated by chezmoi for the "{{ $profile }}" profile (edit profile.conf.tmpl)
{{- if eq $profile "sway" }}

# font, size, padding, opacity, colors and the 16 ANSI come from
# ~/.config/theme/current/kitty.conf (generated from theme.toml; `theme day|night`)
include ~/.config/theme/current/kitty.conf
{{- else if eq $profile "niri" }}

font_family      family="Maple Mono Normal NF"
font_size        10.5
window_padding_width 4
background_opacity 0.93
{{- else }}

font_family      family="GeistMono Nerd Font Mono"
font_size        10.5
window_padding_width 4
background_opacity 0.93
{{- end }}
{{- if eq $profile "niri" }}

# colors generated by noctalia from the wallpaper (noctalia/config.toml, template "kitty")
include themes/noctalia.conf
{{- end }}
