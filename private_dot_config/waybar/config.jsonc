{
  "spacing": 0,
    "height": 0,
    "margin-top": 0,
    "margin-bottom": 0,
    "margin-right": 0,
    "margin-left": 0,
    "position": "top",
    "layer": "top",

    "modules-left": [
      "custom/clock",
      "sway/workspaces",
      "sway/mode",
      "battery#group",
      "backlight#group"
    ],

    "modules-center": [
      "mpris"
    ],

    "modules-right": [
      "tray",
      "custom/updates",
      "group/notif",
      "bluetooth#group",
      "pulseaudio#group",
      "network"
    ],

    /*left modules */
    "custom/clock": {
      "exec": "~/.config/waybar/scripts/clock-status.sh",
      "return-type": "json",
      "interval": 30,
      "tooltip": true
    },

    "sway/workspaces": {
      "disable-scroll": true,
      "all-outputs": false,
      "tooltip": false
    },

    /* battery: contextual. Hidden (empty format) when plugged or full */
    "battery#group": {
      "format": "{icon} {capacity}%",
      "format-charging": "󰂄 {capacity}%",
      "format-plugged": "",
      "format-full": "",
      "format-alt": "󱧥 {time}",
      "format-icons": ["󱊡", "󱊢", "󱊣"],
      "states": {
        "warning": 30,
        "critical": 15
      },
      "tooltip": false
    },

    "backlight#group": {
      "device": "intel_backlight",
      "format": "{icon} {percent}%",
      "format-icons": ["󰃞", "󰃟", "󰃠"],
      "on-scroll-up": "brightnessctl set 1%+",
      "on-scroll-down": "brightnessctl set 1%-",
      "min-length": 6,
      "tooltip": false
    },
    /* --- */

    /* middle modules */
    "mpris": {
      "format": "{status_icon}  {dynamic}",
      "dynamic-order": ["artist", "title"],
      "dynamic-separator": " ∕ ",
      "dynamic-len": 55,
      "status-icons": {
        "playing": "󰐊",
        "paused": "󰏤",
        "stopped": "󰓛"
      },
      "tooltip-format": "{player} · {album}",
      "on-click-right": "swaymsg '[app_id=\"jukebox\"] scratchpad show' || launch kitty --app-id jukebox -o window_padding_width=0 rmpc",
      "on-scroll-up": "playerctl next",
      "on-scroll-down": "playerctl previous"
    },
    /* --- */

    /* right modules */
    "tray": {
      "tooltip": false,
      "spacing": 10
    },

    /* updates: contextual. The script prints an empty text when nothing is pending */
    "custom/updates": {
      "format": "{}",
      "return-type": "json",
      "exec": "~/.config/waybar/scripts/updates-status.sh",
      "interval": 1800,
      "signal": 9,
      "on-click": "launch ~/.config/sway/scripts/update.sh"
    },

    /* one chip, two buttons: notifications | idle inhibitor */
    "group/notif": {
      "orientation": "horizontal",
      "modules": ["custom/notification", "idle_inhibitor"]
    },

    /* swaync: icon follows the unread / do-not-disturb state; event driven, no polling */
    "custom/notification": {
      "tooltip": false,
      "format": "{icon}",
      "format-icons": {
        "notification": "󱅫",
        "none": "󰂜",
        "dnd-notification": "󰂛",
        "dnd-none": "󰂛",
        "inhibited-notification": "󰂛",
        "inhibited-none": "󰂛",
        "dnd-inhibited-notification": "󰂛",
        "dnd-inhibited-none": "󰂛"
      },
      "return-type": "json",
      "exec-if": "which swaync-client",
      "exec": "swaync-client -swb",
      "on-click": "swaync-client -t -sw",
      "on-click-right": "swaync-client -d -sw",
      "escape": true
    },

    "idle_inhibitor": {
      "format": "{icon}",
      "format-icons": {
        "activated": "󰅶",
        "deactivated": "󰾪"
      },
      "tooltip-format-activated": "Inhibidor de reposo: activo\nLa pantalla no se bloqueará",
      "tooltip-format-deactivated": "Inhibidor de reposo: inactivo\nBloqueo a los 3 min de inactividad"
    },

    /* bluetooth: contextual. Hidden when off or disabled */
    "bluetooth#group": {
      "format": "󰂯",
      "format-off": "",
      "format-disabled": "",
      "format-connected": "󰂯 {status} {device_battery_percentage}",
      "format-connected-battery": "{icon} {device_battery_percentage}%",
      "format-icons": ["󰥇", "󰤾", "󰤿", "󰥀", "󰥁", "󰥂", "󰥃", "󰥄", "󰥅", "󰥆", "󰥈"],
      "tooltip": false,
      "on-click": "launch blueman-manager"

    },

    "pulseaudio#group": {
      "format": "{icon} {volume}% {format_source}",
      "format-muted": "󰖁 {format_source}",
      "format-source": "󰍬",
      "format-source-muted": "󰍭",
      "format-icons": ["󰕿", "󰖀", "󰕾"],
      "tooltip": false,
      "on-click": "launch pavucontrol",
      "nospacing": 1,
      "scroll-step": 5,
      "max-volume": 100
    },

    "network": {
      "format-wifi": "󰖩 {signalStrength}%",
      "format-ethernet": "󰈀 Eth",
      "format-disconnected": "󰤮 Sin red",
      "tooltip": false,
      "on-click": "launch nm-connection-editor"
    }
}
