{
  "positionX": "left",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "user",
  "control-center-margin-top": 88,
  "control-center-margin-bottom": 0,
  "control-center-margin-right": 0,
  "control-center-margin-left": 42,
  "control-center-width": 320,
  "control-center-height": 420,
  "notification-window-width": 340,
  "notification-icon-size": 36,
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,
  "image-visibility": "when-available",
  "timeout": 4,
  "timeout-low": 3,
  "timeout-critical": 0,
  "transition-time": 180,
  "fit-to-screen": false,
  "keyboard-shortcuts": true,
  "hide-on-clear": true,
  "hide-on-action": true,
  "script-fail-notify": true,
  "notification-visibility": {
    "system-osd": {
      "state": "transient",
      "app-name": "^System$"
    }
  },
  "widgets": [
    "title",
    "dnd",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "Notificaciones",
      "clear-all-button": true,
      "button-text": "Limpiar"
    },
    "dnd": {
      "text": "No molestar"
    }
  },
  "control-center-positionX": "left",
  "control-center-positionY": "top"
}
