// Generated by noctalia from the wallpaper (template: ~/.config/noctalia/templates/niri.kdl). Do not edit.
// Included last by config.kdl (optional include), so it overrides the colors of windows/.

layout {
    focus-ring {
        off
    }

    // the gradient spans the whole view: windows sweep through it as they scroll
    border {
        on
        width 2
        active-gradient from="{{colors.primary.default.hex}}" to="{{colors.tertiary.default.hex}}" angle=135 relative-to="workspace-view"
        inactive-color "{{colors.surface_container_highest.default.hex}}"
        urgent-color "{{colors.error.default.hex}}"
    }

    shadow {
        on
        softness 30
        spread 4
        offset x=0 y=8
        color "{{colors.shadow.default.hex}}aa"
        inactive-color "{{colors.shadow.default.hex}}55"
    }

    tab-indicator {
        width 4
        gap 6
        corner-radius 4
        active-color "{{colors.primary.default.hex}}"
        inactive-color "{{colors.surface_container_highest.default.hex}}"
        urgent-color "{{colors.error.default.hex}}"
    }

    insert-hint {
        color "{{colors.primary.default.hex}}66"
    }
}

recent-windows {
    highlight {
        active-color "{{colors.primary.default.hex}}"
        urgent-color "{{colors.error.default.hex}}"
    }
}
